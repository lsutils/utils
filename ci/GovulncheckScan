name: GovulncheckScan
on:
push:
    branches:["main"]
pull_request:
schedule:
    # 每天 UTC 时间 10:22 执行
    -cron:'22 10 * * *'
workflow_dispatch:

permissions:
contents:read

jobs:
govulncheck:
    runs-on:ubuntu-latest
    steps:
      -uses:actions/checkout@v5
        with:
          persist-credentials:false
          
      -uses:actions/setup-go@v6
        with:
          go-version-file:go.mod
          
      -name:Rungovulncheck
        run: |
          go run golang.org/x/vuln/cmd/govulncheck@latest ./...
